<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="database" path="CampusBite_DB" />
        <exclude domain="database" path="CampusBite_DB-wal" />
        <exclude domain="database" path="CampusBite_DB-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Encrypted session keys are device-bound, so they must not follow the user. -->
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="database" path="CampusBite_DB" />
        <exclude domain="database" path="CampusBite_DB-wal" />
        <exclude domain="database" path="CampusBite_DB-shm" />
    </device-transfer>
</data-extraction-rules>
